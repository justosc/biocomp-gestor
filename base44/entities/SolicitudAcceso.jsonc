{
  "name": "SolicitudAcceso",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "aprobada",
        "rechazada"
      ],
      "default": "pendiente"
    },
    "roleAsignado": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "email",
    "estado"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}